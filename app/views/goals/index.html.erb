<div class="container-fluid pt-2"> <!-- Cambia py-4 por pt-2 para menos espacio arriba -->
  <div class="row">
    <div class="col-12">
      <div class="card mb-4">
        <div class="card-header pb-0 d-flex justify-content-between align-items-center flex-wrap">
          <h6 class="mb-0">Goals</h6>
          <div class="d-flex align-items-center gap-2 flex-wrap">
              <div>
                <%= label_tag :title, "Title", class: "form-label mb-0 me-1" %>
                <%= text_field_tag :title, params[:title], class: "form-control form-control-sm d-inline-block", style: "width: 150px;" %>
              </div>
              <div>
                <%= label_tag :state, "State", class: "form-label mb-0 me-1" %>
                <%= select_tag :state, options_for_select([["All", ""], ["In Progress", Goal::IN_PROGRESS_STATE], ["Deleted", Goal::DELETED_STATE], ["Completed", Goal::COMPLETED_STATE]], params[:state]), class: "form-select form-select-sm d-inline-block", style: "width: 130px;" %>
              </div>
              <button class="btn btn-primary btn-sm me-10 mt-3" id="filter">Filter</button>
              <button type="button" class="btn btn-info btn-sm" data-bs-toggle="modal" data-bs-target="#modalCreate">
              Create Goal
            </button>
          </div>
        </div>
        <!-- Fin filtros -->
        <%= render "goals/partials/goalList", goals: @goals %>
      </div>
    </div>
  </div>
</div>

<!-- Modal to create -->
<div class="modal fade" id="modalCreate" tabindex="-1" aria-labelledby="modalCreateLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalCreateLabel">Create Goal</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <%= render 'goals/partials/form', goal: @goal %>
      </div>
    </div>
  </div>
</div>

<%= render "goals/partials/editGoalModal" %>

<% content_for :javascript do %>

<script>
document.addEventListener("DOMContentLoaded", function() {
  document.getElementById('filter').addEventListener('click', function(e) {
    e.preventDefault();

    const titleinput = title.value;
    const stateInput = state.value;

    fetch(`/goals?title=${encodeURIComponent(titleinput)}&state=${encodeURIComponent(stateInput)}`, {
      headers: { 'Accept': 'text/javascript' } 
    })
    .then(response => response.text())
    .then(html => {
      document.getElementById('goalsContainer').innerHTML = html;
    })
    .catch(error => console.error('Error fetching goals:', error));
  });
});
</script>

<% end %>