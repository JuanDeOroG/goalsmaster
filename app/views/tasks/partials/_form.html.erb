<% content_for "head" do %>
<style>
    .card {
    border-radius: 10px; /* Bordes redondeados */
  }
</style>
<% end %>

<%= form_with(model: task, url: task.new_record? ? tasks_path : task_path(task), method: task.new_record? ? :post : :patch, local: true) do |f| %>
<div>
  <%= f.label :name, class: "form-label text-dark fw-bold" %>
  <%= f.text_field :name, class: "form-control" %>
</div>

<div>
  <%= f.label :descriptcion, class: "form-label text-dark fw-bold" %>
  <%= f.text_area :descriptcion, class: "form-control" %>
</div>

<div>
  <%= f.label :limit_time, class: "form-label text-dark fw-bold" %>
  <%= f.datetime_field :limit_time, class: "form-control" %>
</div>
  
  <%= f.hidden_field :goal_id, value: @goal.id %>
  <%= f.hidden_field :user_id, value: current_user.id %>

<div>
  <%= f.label :state, class: "form-label text-dark fw-bold" %>
  <%= f.number_field :state, class: "form-control" %>
</div>

  <div class="text-center">
    <%= f.submit task.new_record? ? "Create" : "Update", class: "btn btn-round bg-gradient-info btn-lg w-100 mt-4 mb-0" %>
  </div>
<% end %>
